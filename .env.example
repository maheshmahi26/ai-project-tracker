# ── AI ProjectOS — environment template ───────────────────────────────────────
# Copy to `.env` (never commit `.env`). Values below match the local Docker stack
# in docker/docker-compose.yml. The API validates these at boot (Zod) and fails
# fast if anything required is missing. See specs/09-devops-deployment.md.

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma-separated allowlist for CORS (the web dev server origin)
CORS_ORIGINS=http://localhost:5173

# ── Rate limiting (global, Redis-backed) ──────────────────────────────────────
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# ── MongoDB (local single-node replica set → transactions work) ───────────────
MONGODB_URI=mongodb://localhost:27017/ai_projectos?replicaSet=rs0&directConnection=true

# ── Redis (cache + BullMQ) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Dashboard read-model cache TTL (seconds); writes invalidate immediately
DASHBOARD_CACHE_TTL_SEC=30

# ── Qdrant (vector DB for RAG) ────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=            # not needed for local Qdrant

# ── Object storage (MinIO locally; Cloudflare R2 / S3 in prod) ────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=ai-projectos
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# ── App URLs (password-reset links, OAuth success redirect) ───────────────────
WEB_APP_URL=http://localhost:5173

# ── Auth / JWT (generate strong random secrets; >= 16 chars) ──────────────────
JWT_ACCESS_SECRET=change-me-dev-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-dev-refresh-secret
JWT_REFRESH_TTL=7d
REFRESH_COOKIE_NAME=apos_rt
RESET_TOKEN_TTL_MIN=30

# ── Google OAuth (optional — leave empty to disable social login) ──────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# ── Email (console transport in dev prints emails to the log) ─────────────────
MAIL_TRANSPORT=console
MAIL_FROM=no-reply@ai-projectos.local
# SMTP_URL=smtp://user:pass@host:587

# ── AI (added in the AI phase — leave empty until then) ───────────────────────
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
# Agent guardrails
AI_MAX_ITERATIONS=6
AI_TOKEN_BUDGET=24000
AI_NODE_TIMEOUT_MS=45000
AI_RUN_TIMEOUT_MS=120000

# ── Observability (optional locally) ──────────────────────────────────────────
# Sentry error tracking (backend). Leave empty to disable.
# SENTRY_DSN=
# Release identifier (usually the git SHA); set by CI on deploy.
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# OpenTelemetry OTLP/HTTP traces endpoint (e.g. a local collector on :4318).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=ai-projectos-api
# Better Stack (Logtail) — structured log ingestion in prod. Leave empty locally.
# BETTER_STACK_SOURCE_TOKEN=
# BETTER_STACK_INGEST_URL=https://s1234567.eu-nbg-2.betterstackdata.com
LOG_LEVEL=info

# ── Frontend (Vite — only VITE_* vars are exposed to the browser) ─────────────
# VITE_SENTRY_DSN=
# VITE_SENTRY_RELEASE=
# VITE_API_TARGET=http://localhost:3000
